# Site champis.app (adhumi/champis-web) : service statique Railway depuis le découpage des dépôts
# (spec › Produit › Étape C, lot C7, 6 nov. 2026). Les pages sont à la racine (/, /carte.html…),
# /shared/ et /species/ servent le référentiel (sous-module champis/). L'API est sur api.champis.app :
# ce service ne relaie plus rien vers elle (relais des anciennes versions de l'app retiré le
# 13 nov. 2026), tout chemin qui n'est pas un fichier servi ici répond 404.
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# En-têtes de sécurité, sur toute réponse (13 nov. 2026). La CSP n'ouvre que ce que le code
	# joint (web/tests/test_carte_ids.py compare ses hôtes à ceux de site.js et app.js) :
	# - script-src et worker-src 'self' : aucun script en ligne, MapLibre (module ES) et son worker
	#   viennent de /vendor/, par leur adresse (pas de blob:, pas d'eval) ;
	# - style-src 'unsafe-inline' : blocs <style> des pages et attributs style du rendu (légende,
	#   pastilles) ;
	# - img-src data: (icônes des commandes de MapLibre, dans sa feuille de style) et blob: (repli
	#   de MapLibre pour décoder une tuile là où createImageBitmap manque) ; les fonds de carte
	#   sont lus par fetch, donc par connect-src ;
	# - connect-src : l'API (météo, catalogue, manifeste et tuiles PMTiles, relayées par
	#   /tiles/<nom> : CHAMPIS_TILES_MODE=proxy), la Géoplateforme de l'IGN (fonds Plan IGN et
	#   photo aérienne, recherche de commune, forêts publiques) et OpenStreetMap (fond au choix).
	#   Si l'API repasse en URL présignées, ajouter ici l'hôte du bucket.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "geolocation=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.champis.app https://data.geopf.fr https://tile.openstreetmap.org; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# santé du service lui-même (contrôle de Railway), sans dépendre de l'API
	handle /health {
		respond "ok" 200
	}

	# Anciennes adresses des pages (/web/…, celles d'avant le 13 nov. 2026, encore dans l'app et les
	# liens publiés) : redirigées vers la racine, requête comprise. Seules les pages le sont : les
	# fichiers de /web/ restent servis plus bas, pour les clients qui ne suivent pas les redirections
	# (champis-api et l'app lisent /web/departements.geojson).
	redir /web / 301
	redir /web/ / 301
	redir /web/index.html / 301
	@anciennes_pages path_regexp ^/web/[^/]+\.html$
	handle @anciennes_pages {
		# `route` garde l'ordre écrit : sans lui, `redir` passerait avant `uri` et bouclerait
		route {
			uri strip_prefix /web
			redir {uri} 301
		}
	}

	# Le site, à la racine : / et tout chemin qui est un fichier de web/ (/carte.html, /site.css,
	# /vendor/…).
	rewrite / /index.html
	@site file {
		root /srv/web
		try_files {path}
	}
	handle @site {
		root * /srv/web
		encode zstd gzip
		# bibliothèques versionnées par leur dossier : immuables ; le reste se revalide vite (matchers
		# disjoints : deux `header` sur le même chemin, le dernier l'emporte)
		@vendor path /vendor/*
		header @vendor Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /vendor/*
		header @revalidate Cache-Control "public, max-age=300"
		file_server
	}

	# Le référentiel, et les fichiers du site à leur ancien chemin /web/ (mêmes règles de cache).
	@referentiel path /web/* /shared/* /species/*
	handle @referentiel {
		root * /srv
		encode zstd gzip
		@vendor path /web/vendor/*
		header @vendor Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path /web/vendor/*
		header @revalidate Cache-Control "public, max-age=300"
		file_server
	}

	# Tout le reste n'existe pas ici. Le relais vers l'API (les versions de l'app d'avant le
	# découpage appelaient /weather, /tiles, /observations… sur champis.app) est retiré : l'API
	# n'est jointe que par api.champis.app.
	handle {
		respond "Page introuvable" 404
	}
}
